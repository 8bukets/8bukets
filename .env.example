# Massive-Scale Autonomous Sigma Environment Configuration
# Copy this file to `.env` and fill in your actual production values.

# The authentication token required to initiate or communicate with the system.
# Change this to a strong, random, secure string in production.
SYSTEM_AUTH_TOKEN=your_secure_production_token

# (Optional) Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
# LOG_LEVEL=INFO

# (Optional) GitHub Token for the GitHubEvolutionAgent to commit/push daily upgrades
# GITHUB_TOKEN=your_github_personal_access_token
