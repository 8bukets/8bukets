# MongoDB Connection String
MONGODB_URI=mongodb://localhost:27017/markposition

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Google & Gemini APIs
# IMPORTANT: Provide your actual keys securely in your environment.
# Do not commit real keys to source control.
GOOGLE_API_KEY=your-google-api-key
GEMINI_API_KEY=your-gemini-api-key

# System Authentication Token (used in CI/CD and by autonomous agents)
SYSTEM_AUTH_TOKEN=default_dev_token
ARCJET_KEY=your_arcjet_key_here
