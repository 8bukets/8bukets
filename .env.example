# MongoDB Connection String
MONGODB_URI=mongodb://localhost:27017/markposition

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Google & Gemini APIs
# IMPORTANT: Provide your actual keys securely in your environment.
# Do not commit real keys to source control.
GOOGLE_API_KEY=your-google-api-key
GEMINI_API_KEY=your-gemini-api-key

# System Authentication Token (used in CI/CD and by autonomous agents)
SYSTEM_AUTH_TOKEN=default_dev_token
ARCJET_KEY=your_arcjet_key_here

# Simulation
# To simulate a fully online, cloud-connected MacBook environment bypassing local checks for Docker, GitHub, GitKraken, Supabase, MongoDB, and GitLab, set MACBOOK_CLOUD_SIMULATION to true.
MACBOOK_CLOUD_SIMULATION=true

# iCloud Credentials for sync_icloud.py
# pyicloud requires your primary Apple ID password, not an App-Specific password, to work properly.
APPLE_ID=your-apple-id@example.com
APPLE_PASSWORD=your-apple-id-password

# Docker Hub Credentials
# Used for push_docker.sh and Makefile
DOCKER_USERNAME=getanant
DOCKER_PASSWORD=your_docker_pat_here
AUTONOMOUS_MODE=cloud
