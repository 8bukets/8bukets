# Cloud Environment Configuration Template
# Copy these to your GitHub Secrets and Vercel Environment Variables

# GitHub Automation
GITHUB_TOKEN=your_github_personal_access_token_with_repo_scope

# Database Connections
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/markposition_db
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# System Authentication
SYSTEM_AUTH_TOKEN=your_secure_autonomous_cycle_token

# AI Service Keys
GOOGLE_API_KEY=your_google_ai_api_key
GEMINI_API_KEY=your_gemini_api_key
