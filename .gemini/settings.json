{
  "hooks": {
    "BeforeTool": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "name": "security-check",
            "type": "command",
            "command": "$GEMINI_PROJECT_DIR/.gemini/hooks/security.py",
            "timeout": 5000,
            "description": "Blocks execution of dangerous bash commands and queries."
          }
        ]
      }
    ]
  },
  "agents": {
    "overrides": {
      "browser_agent": {
        "enabled": true,
        "runConfig": {
          "maxTurns": 100,
          "maxTimeMinutes": 30
        }
      },
      "collaborator": {
        "enabled": true,
        "runConfig": {
          "maxTurns": 50,
          "maxTimeMinutes": 20
        }
      },
      "security-auditor": {
        "enabled": true,
        "runConfig": {
          "maxTurns": 50,
          "maxTimeMinutes": 20
        }
      },
      "daily-tasks": {
        "enabled": true,
        "runConfig": {
          "maxTurns": 50,
          "maxTimeMinutes": 20
        }
      },
      "highlander": {
        "enabled": true,
        "runConfig": {
          "maxTurns": 50,
          "maxTimeMinutes": 20
        }
      }
    },
    "browser": {
      "sessionMode": "persistent",
      "maxActionsPerTask": 500,
      "visualModel": "gemini-2.5-computer-use-preview-10-2025"
    }
  },
  "general": {
    "proxy": "http://my-proxy:8080"
  },
  "experimental": {
    "enableAgents": true
  }
}
