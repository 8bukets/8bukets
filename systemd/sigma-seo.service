[Unit]
Description=Massive Scale Autonomous Sigma SEO System
After=network.target

[Service]
Type=simple
User=jules
WorkingDirectory=/app
Environment="SYSTEM_AUTH_TOKEN=default_dev_token"
Environment="MONGODB_URI=mongodb://localhost:27017/markposition"
Environment="NEXT_PUBLIC_SUPABASE_URL=your-supabase-url"
Environment="NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key"
Environment="MACBOOK_CLOUD_SIMULATION=true"
ExecStart=/usr/bin/npm run ignite
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
