# Gemini CLI Ignore File
# Excludes files and directories from Gemini CLI operations

# Dependencies
node_modules/
__pycache__/

# Compiled files
*.pyc
*.pyo
dist/
build/

# Environment files
.env
.env.local
.env.*

# Git
.git/

# Large data and outputs
links.json
links.csv
unique_links.txt

# Binary and media files
*.png
*.jpg
*.jpeg
*.gif
*.webp
*.mp4
*.webm
*.mov
*.zip
*.tar.gz

# Coverage and testing outputs
coverage/
.coverage
htmlcov/
